{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "magnetic",
  "type": "registry:component",
  "title": "Magnetic",
  "description": "Native custom element with GSAP-powered magnetic hover motion and no Lit dependency.",
  "dependencies": ["gsap"],
  "files": [
    {
      "path": "src/registry/new-york/blocks/magnetic/magnetic-element.ts",
      "type": "registry:component",
      "target": "src/components/motion-kit/magnetic-element.ts"
    }
  ],
  "usage": [
    {
      "label": "Astro",
      "code": "---\nimport \"@/components/motion-kit/magnetic-element.ts\";\n---\n\n<motion-magnetic-native duration=\"1\" strength=\"0.35\">\n  <button>Hover me</button>\n</motion-magnetic-native>"
    },
    {
      "label": "React",
      "code": "import \"@/components/motion-kit/magnetic-element.ts\";\n\nexport default function Page() {\n  return (\n    <motion-magnetic-native duration=\"1\" strength=\"0.35\">\n      <button>Hover me</button>\n    </motion-magnetic-native>\n  );\n}"
    },
    {
      "label": "Vue",
      "code": "<script setup>\nimport \"@/components/motion-kit/magnetic-element.ts\";\n</script>\n\n<template>\n  <motion-magnetic-native duration=\"1\" strength=\"0.35\">\n    <button>Hover me</button>\n  </motion-magnetic-native>\n</template>"
    },
    {
      "label": "Svelte",
      "code": "<script>\n  import \"@/components/motion-kit/magnetic-element.ts\";\n</script>\n\n<motion-magnetic-native duration=\"1\" strength=\"0.35\">\n  <button>Hover me</button>\n</motion-magnetic-native>"
    },
    {
      "label": "HTML",
      "code": "<script type=\"module\" src=\"/components/motion-kit/magnetic-element.js\"></script>\n\n<motion-magnetic-native duration=\"1\" strength=\"0.35\">\n  <button>Hover me</button>\n</motion-magnetic-native>"
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": "1",
      "description": "Animation duration in seconds."
    },
    {
      "name": "strength",
      "type": "number",
      "default": "1",
      "description": "Movement multiplier applied to the cursor offset."
    },
    {
      "name": "ease",
      "type": "string",
      "default": "\"elastic.out(1, 0.3)\"",
      "description": "GSAP easing function string."
    }
  ]
}
