  ],
  "props": [
    {
      "name": "columns",
      "type": "number",
      "default": "0",
      "description": "Number of columns in the grid (0 for auto-layout)."
    },
    {
      "name": "duration",
      "type": "number",
      "default": "0.5",
      "description": "Animation duration in seconds."
    },
    {
      "name": "ease",
      "type": "string",
      "default": "\"power2.inOut\"",
      "description": "GSAP easing function for animations."
    },
    {
      "name": "stagger",
      "type": "number",
      "default": "0",
      "description": "Stagger delay in seconds between item animations."
    },
    {
      "name": "gap",
      "type": "string",
      "default": "\"\"",
      "description": "CSS gap value between grid items."
    }
  ]
}
