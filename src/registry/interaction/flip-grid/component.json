  "name": "flip-grid",
  "type": "registry:component",
  "title": "Flip Grid",
  "description": "A FLIP-powered grid that animates reordering and layout changes. Framework-agnostic Custom Elements.",
  "dependencies": ["gsap"],
  "files": [
    {
      "path": "src/registry/new-york/blocks/flip-grid/flip-grid-element.ts",
      "type": "registry:component",
      "target": "src/components/motion-kit/flip-grid-element.ts"
    },
    {
      "path": "src/registry/new-york/blocks/flip-grid/flip-grid-item-element.ts",
      "type": "registry:component",
      "target": "src/components/motion-kit/flip-grid-item-element.ts"
    }
  ],
  "usage": [
    {
      "label": "Astro",
      "code": "---\nimport \"@/components/motion-kit/flip-grid-element.ts\";\nimport \"@/components/motion-kit/flip-grid-item-element.ts\";\n---\n\n<motion-flip-grid\n  columns=\"3\"\n  duration=\"0.5\"\n  ease=\"power2.inOut\"\n  stagger=\"0\"\n  gap=\"1rem\"\n  class=\"w-full\"\n>\n  <div class=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 1</div>\n  <div class=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 2</div>\n  <div class=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 3</div>\n  <div class=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 4</div>\n</motion-flip-grid>"
    },
    {
      "label": "React",
      "code": "import \"@/components/motion-kit/flip-grid-element.ts\";\nimport \"@/components/motion-kit/flip-grid-item-element.ts\";\n\nexport default function Page() {\n  return (\n    <motion-flip-grid\n      columns={3}\n      duration={0.5}\n      ease=\"power2.inOut\"\n      stagger={0}\n      gap=\"1rem\"\n      className=\"w-full\"\n    >\n      <div className=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 1</div>\n      <div className=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 2</div>\n      <div className=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 3</div>\n      <div className=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 4</div>\n    </motion-flip-grid>\n  );\n}"
    },
    {
      "label": "Vue",
      "code": "<script setup>\nimport \"@/components/motion-kit/flip-grid-element.ts\";\nimport \"@/components/motion-kit/flip-grid-item-element.ts\";\n</script>\n\n<template>\n  <motion-flip-grid\n    :columns=\"3\"\n    :duration=\"0.5\"\n    ease=\"power2.inOut\"\n    :stagger=\"0\"\n    gap=\"1rem\"\n    class=\"w-full\"\n  >\n    <div class=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 1</div>\n    <div class=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 2</div>\n    <div class=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 3</div>\n    <div class=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 4</div>\n  </motion-flip-grid>\n</template>"
    },
    {
      "label": "Svelte",
      "code": "<script>\n  import \"@/components/motion-kit/flip-grid-element.ts\";\n  import \"@/components/motion-kit/flip-grid-item-element.ts\";\n</script>\n\n<motion-flip-grid\n  columns={3}\n  duration={0.5}\n  ease=\"power2.inOut\"\n  stagger={0}\n  gap=\"1rem\"\n  class=\"w-full\"\n>\n  <div class=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 1</div>\n  <div class=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 2</div>\n  <div class=\"flip-grid-item h-32 bg-white rounded-lg p-4\">Item 3</div>\n  <div class=\"flip-grid-item h-32 bg-slate-50 rounded-lg p-4\">Item 4</div>\n</motion-flip-grid>"
