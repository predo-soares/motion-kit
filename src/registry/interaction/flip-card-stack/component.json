{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "flip-card-stack",
  "type": "registry:component",
  "title": "Flip Card Stack",
  "description": "A draggable card stack where the top card snaps to the back after a threshold drag. Framework-agnostic Custom Element.",
  "dependencies": ["gsap"],
  "files": [
    {
      "path": "src/registry/interaction/flip-card-stack/flip-card-stack-element.ts",
      "type": "registry:component",
      "target": "src/components/motion-kit/flip-card-stack-element.ts"
    }
  ],
  "usage": [
    {
      "label": "Astro",
      "code": "---\nimport \"@/components/motion-kit/flip-card-stack-element.ts\";\n---\n\n<motion-flip-card-stack\n  stack-offset=\"8\"\n  stack-rotation=\"-10\"\n  drag-threshold=\"80\"\n  duration=\"0.3\"\n  ease=\"power2.out\"\n  class=\"inline-grid relative w-[320px] h-[480px]\"\n>\n  <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n    <h2>Card 1</h2>\n  </div>\n  <div class=\"flip-grid-item w-full h-full bg-slate-50 rounded-2xl p-6\">\n    <h2>Card 2</h2>\n  </div>\n  <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n    <h2>Card 3</h2>\n  </div>\n</motion-flip-card-stack>"
    },
    {
      "label": "React",
      "code": "import \"@/components/motion-kit/flip-card-stack-element.ts\";\n\nexport default function Page() {\n  return (\n    <motion-flip-card-stack\n      stackOffset={8}\n      stackRotation={-10}\n      dragThreshold={80}\n      duration={0.3}\n      ease=\"power2.out\"\n      className=\"inline-grid relative w-[320px] h-[480px]\"\n    >\n      <div className=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n        <h2>Card 1</h2>\n      </div>\n      <div className=\"flip-grid-item w-full h-full bg-slate-50 rounded-2xl p-6\">\n        <h2>Card 2</h2>\n      </div>\n      <div className=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n        <h2>Card 3</h2>\n      </div>\n    </motion-flip-card-stack>\n  );\n}"
    },
    {
      "label": "Vue",
      "code": "<script setup>\nimport \"@/components/motion-kit/flip-card-stack-element.ts\";\n</script>\n\n<template>\n  <motion-flip-card-stack\n    :stack-offset=\"8\"\n    :stack-rotation=\"-10\"\n    :drag-threshold=\"80\"\n    :duration=\"0.3\"\n    ease=\"power2.out\"\n    class=\"inline-grid relative w-[320px] h-[480px]\"\n  >\n    <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n      <h2>Card 1</h2>\n    </div>\n    <div class=\"flip-grid-item w-full h-full bg-slate-50 rounded-2xl p-6\">\n      <h2>Card 2</h2>\n    </div>\n    <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n      <h2>Card 3</h2>\n    </div>\n  </motion-flip-card-stack>\n</template>"
    },
    {
      "label": "Svelte",
      "code": "<script>\n  import \"@/components/motion-kit/flip-card-stack-element.ts\";\n</script>\n\n<motion-flip-card-stack\n  stackOffset={8}\n  stackRotation={-10}\n  dragThreshold={80}\n  duration={0.3}\n  ease=\"power2.out\"\n  class=\"inline-grid relative w-[320px] h-[480px]\"\n>\n  <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n    <h2>Card 1</h2>\n  </div>\n  <div class=\"flip-grid-item w-full h-full bg-slate-50 rounded-2xl p-6\">\n    <h2>Card 2</h2>\n  </div>\n  <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n    <h2>Card 3</h2>\n  </div>\n</motion-flip-card-stack>"
    },
    {
      "label": "HTML",
      "code": "<script type=\"module\" src=\"/components/motion-kit/flip-card-stack-element.js\"></script>\n\n<motion-flip-card-stack\n  stack-offset=\"8\"\n  stack-rotation=\"-10\"\n  drag-threshold=\"80\"\n  duration=\"0.3\"\n  ease=\"power2.out\"\n  class=\"inline-grid relative w-[320px] h-[480px]\"\n>\n  <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n    <h2>Card 1</h2>\n  </div>\n  <div class=\"flip-grid-item w-full h-full bg-slate-50 rounded-2xl p-6\">\n    <h2>Card 2</h2>\n  </div>\n  <div class=\"flip-grid-item w-full h-full bg-white rounded-2xl p-6\">\n    <h2>Card 3</h2>\n  </div>\n</motion-flip-card-stack>"
    }
  ],
  "props": [
    {
      "name": "stack-offset",
      "type": "number",
      "default": "8",
      "description": "Vertical offset (in pixels) between stacked cards."
    },
    {
      "name": "stack-rotation",
      "type": "number",
      "default": "-10",
      "description": "Rotation angle (in degrees) for each card in the stack."
    },
    {
      "name": "drag-threshold",
      "type": "number",
      "default": "80",
      "description": "Distance (in pixels) the card must be dragged before it snaps to the back."
    },
    {
      "name": "duration",
      "type": "number",
      "default": "0.3",
      "description": "Animation duration in seconds."
    },
    {
      "name": "ease",
      "type": "string",
      "default": "\"power2.out\"",
      "description": "easing function for card animations."
    }
  ]
}
