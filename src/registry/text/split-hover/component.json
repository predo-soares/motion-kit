{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "split-hover",
  "type": "registry:component",
  "title": "Split Hover",
  "description": "Splits text into characters and animates stacked layers on hover for a seamless swap. Framework-agnostic Custom Element.",
  "dependencies": ["lit", "gsap"],
  "registryDependencies": ["gsap"],
  "files": [
    {
      "path": "src/registry/text/split-hover/split-hover-element.ts",
      "type": "registry:component",
      "target": "src/components/motion-kit/split-hover-element.ts"
    }
  ],
  "usage": [
    {
      "label": "Astro",
      "code": "---\nimport \"@/components/motion-kit/split-hover-element.ts\";\n---\n\n<motion-split-hover text=\"Hover me\"></motion-split-hover>"
    },
    {
      "label": "React",
      "code": "import \"@/components/motion-kit/split-hover-element.ts\";\n\nexport default function Page() {\n  return (\n    <motion-split-hover text=\"Hover me\" />\n  );\n}"
    },
    {
      "label": "Vue",
      "code": "<script setup>\nimport \"@/components/motion-kit/split-hover-element.ts\";\n</script>\n\n<template>\n  <motion-split-hover text=\"Hover me\" />\n</template>"
    },
    {
      "label": "Svelte",
      "code": "<script>\n  import \"@/components/motion-kit/split-hover-element.ts\";\n</script>\n\n<motion-split-hover text=\"Hover me\" />"
    },
    {
      "label": "HTML",
      "code": "<script type=\"module\" src=\"/components/motion-kit/split-hover-element.js\"></script>\n\n<motion-split-hover text=\"Hover me\"></motion-split-hover>"
    }
  ],
  "props": [
    {
      "name": "text",
      "type": "string",
      "default": "\"\"",
      "description": "The text content to display and animate."
    }
  ]
}
