---
interface Item {
  href: string;
  label: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = "On This Page", items } = Astro.props;
---

<nav aria-label={title} class="flex flex-col gap-3 text-sm">
  <p class="text-xs font-medium tracking-tight text-slate-400">{title}</p>
  <div class="flex flex-col gap-2">
    {items.map((item) => (
      <a
        href={item.href}
        class="text-[13px] leading-5 text-slate-500 transition-colors hover:text-slate-950"
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>
