---
import CodeLines from "./code-lines.astro";

interface Props {
  code: string;
  label?: string;
  wrap?: boolean;
  showLineNumbers?: boolean;
  highlightLines?: number[];
}

const { code, label, wrap = false, showLineNumbers = false, highlightLines = [] } = Astro.props;
---

<figure class="my-4 w-full min-w-0 overflow-hidden rounded-3xl bg-slate-100">
  {
    label ? (
      <figcaption class="border-b border-slate-400/60 px-4 py-2 text-xs font-medium text-slate-700">
        {label}
      </figcaption>
    ) : null
  }
  <pre
    class:list={[
      "w-full min-w-0 overflow-x-auto py-3 text-sm leading-6 text-slate-950",
      wrap && "whitespace-pre-wrap",
    ]}><CodeLines code={code} showLineNumbers={showLineNumbers} highlightLines={highlightLines} /></pre>
</figure>
