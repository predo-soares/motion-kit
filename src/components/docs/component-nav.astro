---
import chevronLeftIcon from "@tabler/icons/outline/chevron-left.svg?raw";
import chevronRightIcon from "@tabler/icons/outline/chevron-right.svg?raw";
import { componentCatalog } from "@/lib/catalog";

interface Props {
  currentSlug: string;
  variant?: "icon" | "footer";
}

const { currentSlug, variant = "icon" } = Astro.props;

const index = componentCatalog.findIndex((c) => c.slug === currentSlug);
const prev = index > 0 ? componentCatalog[index - 1] : null;
const next = index < componentCatalog.length - 1 ? componentCatalog[index + 1] : null;
---

{
  variant === "footer" ? (
    <nav
      class="flex w-full items-stretch justify-between gap-4 border-t border-slate-200 pt-6"
      aria-label="Component navigation"
    >
      <a
        href={prev ? `/docs/components/${prev.slug}` : undefined}
        data-audio-hover="hover"
        data-audio-click="tab-switch"
        aria-label={prev ? `Previous: ${prev.title}` : "No previous component"}
        title={prev ? prev.title : "No previous component"}
        aria-disabled={!prev}
        class:list={[
          "group inline-flex min-w-0 items-center gap-2.5 rounded-xl border px-3 py-2 text-left transition-colors",
          prev
            ? "border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-950"
            : "pointer-events-none border-slate-100 bg-slate-50 text-slate-300",
        ]}
        tabindex={prev ? 0 : -1}
      >
        <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-current">
          <span
            aria-hidden="true"
            class="[&_svg]:block [&_svg]:h-3.5 [&_svg]:w-3.5"
            set:html={chevronLeftIcon}
          />
        </span>
        <span class="truncate text-sm font-medium text-current">
          {prev?.title ?? "No previous component"}
        </span>
      </a>
      <a
        href={next ? `/docs/components/${next.slug}` : undefined}
        data-audio-hover="hover"
        data-audio-click="tab-switch"
        aria-label={next ? `Next: ${next.title}` : "No next component"}
        title={next ? next.title : "No next component"}
        aria-disabled={!next}
        class:list={[
          "group inline-flex min-w-0 items-center gap-2.5 rounded-xl border px-3 py-2 text-right transition-colors",
          next
            ? "border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-950"
            : "pointer-events-none border-slate-100 bg-slate-50 text-slate-300",
        ]}
        tabindex={next ? 0 : -1}
      >
        <span class="truncate text-sm font-medium text-current">
          {next?.title ?? "No next component"}
        </span>
        <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-current">
          <span
            aria-hidden="true"
            class="[&_svg]:block [&_svg]:h-3.5 [&_svg]:w-3.5"
            set:html={chevronRightIcon}
          />
        </span>
      </a>
    </nav>
  ) : (
    <nav class="flex items-center gap-1" aria-label="Component navigation">
      <a
        href={prev ? `/docs/components/${prev.slug}` : undefined}
        data-audio-hover="hover"
        data-audio-click="tab-switch"
        aria-label={prev ? `Previous: ${prev.title}` : "No previous component"}
        title={prev ? prev.title : "No previous component"}
        aria-disabled={!prev}
        class:list={[
          "inline-flex h-7 w-7 items-center justify-center rounded-xl border transition-colors",
          prev
            ? "border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900"
            : "pointer-events-none border-slate-100 bg-slate-50 text-slate-300",
        ]}
        tabindex={prev ? 0 : -1}
      >
        <span
          aria-hidden="true"
          class="[&_svg]:block [&_svg]:h-3.5 [&_svg]:w-3.5"
          set:html={chevronLeftIcon}
        />
      </a>
      <a
        href={next ? `/docs/components/${next.slug}` : undefined}
        data-audio-hover="hover"
        data-audio-click="tab-switch"
        aria-label={next ? `Next: ${next.title}` : "No next component"}
        title={next ? next.title : "No next component"}
        aria-disabled={!next}
        class:list={[
          "inline-flex h-7 w-7 items-center justify-center rounded-xl border transition-colors",
          next
            ? "border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900"
            : "pointer-events-none border-slate-100 bg-slate-50 text-slate-300",
        ]}
        tabindex={next ? 0 : -1}
      >
        <span
          aria-hidden="true"
          class="[&_svg]:block [&_svg]:h-3.5 [&_svg]:w-3.5"
          set:html={chevronRightIcon}
        />
      </a>
    </nav>
  )
}
