<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";
  import "@/registry/new-york/blocks/card-stack/card-stack-element.ts";
  import "@/registry/new-york/blocks/card-stack/card-stack-item-element.ts";
  import "@/registry/new-york/blocks/magnetic/magnetic-element.ts";
  import "@/registry/new-york/blocks/magnetic-lit/magnetic-element.ts";
  import "@/registry/new-york/blocks/progressive-blur/progressive-blur-element.ts";
  import "@/registry/new-york/blocks/text-loop/text-loop-element.ts";
  import "@/registry/new-york/blocks/text-scramble/text-scramble-element.ts";
  import "@/registry/new-york/blocks/text-repel/text-repel-element.ts";
  import "@/registry/new-york/blocks/split-reveal/split-reveal-element.ts";
  import "@/registry/new-york/blocks/stacking-words/stacking-words-element.ts";
  import "@/registry/new-york/blocks/split-hover/split-hover-element.ts";
  import "@/registry/new-york/blocks/weight-wave/weight-wave-element.ts";
  import "@/registry/new-york/blocks/marquee/marquee-element.ts";
  import "@/registry/new-york/blocks/logo-carousel/logo-carousel-element.ts";
  import "@/registry/new-york/blocks/slideshow/slideshow-element.ts";
  import "@/registry/new-york/blocks/radial-gallery/radial-gallery-element.ts";
  import "@/registry/new-york/blocks/infinite-physics-gallery/infinite-physics-gallery-element.ts";
  import "@/registry/new-york/blocks/video-player/video-player-element.ts";
  import "@/registry/new-york/blocks/card-3d/card-3d-element.ts";
  import "@/registry/new-york/blocks/dithered-image/dithered-image-element.ts";
  import "@/registry/new-york/blocks/fake-3d-image/fake-3d-image-element.ts";
  import "@/registry/new-york/blocks/fluid-simulation/fluid-simulation-element.ts";
  import "@/registry/new-york/blocks/fluid-image-reveal/fluid-image-reveal-element.ts";
  import "@/registry/new-york/blocks/glass-logo/glass-logo-element.ts";
  import "@/registry/new-york/blocks/glass-pane/glass-pane-element.ts";
  import "@/registry/new-york/blocks/ascii-renderer/ascii-renderer-element.ts";
  import "@/components/ui/mk-slider.ts";
  import "@/components/ui/mk-color.ts";
  import "@/components/ui/mk-select.ts";

  gsap.registerPlugin(Flip);

  type FullscreenCardState = {
    card: HTMLElement;
    placeholder: HTMLDivElement;
    backdrop: HTMLDivElement;
    originalBorderRadius: string;
    originalParent: Node;
    originalNext: Node | null;
  };

  let fullscreenState: FullscreenCardState | null = null;

  const isIgnoredFullscreenTarget = (event: Event) =>
    event.composedPath().some((node) => {
      if (!(node instanceof HTMLElement)) return false;
      return Boolean(
        node.matches(
          "button, a, input, select, textarea, label, summary, [contenteditable='true'], [data-card-fullscreen-ignore]",
        ),
      );
    });

  const replayPreview = (card: HTMLElement) => {
    const preview = card.querySelector("[data-preview]");
    if (!preview) return;

    preview.querySelectorAll("*").forEach((element) => {
      if (typeof (element as any).replay === "function") {
        (element as any).replay();
      }
    });
  };

  const copyText = async (button: HTMLButtonElement) => {
    const text = button.dataset.copyText;
    if (!text) return;

    await navigator.clipboard.writeText(text);

    const original = button.textContent;
    button.textContent = "Copied!";
    window.setTimeout(() => {
      button.textContent = original;
    }, 1800);
  };

  const closeFullscreenCard = () => {
    const state = fullscreenState;
    if (!state) return;

    const {
      card,
      placeholder,
      backdrop,
      originalBorderRadius,
      originalParent,
    } = state;

    const targetRect = placeholder.getBoundingClientRect();

    gsap.to(backdrop, { opacity: 0, duration: 0.3, ease: "power2.out" });

    gsap.to(card, {
      top: targetRect.top,
      left: targetRect.left,
      width: targetRect.width,
      height: targetRect.height,
      borderRadius: originalBorderRadius,
      duration: 0.55,
      ease: "power3.inOut",
      onComplete: () => {
        card.dataset.fullscreenActive = "false";
        const previewContent = card.querySelector(
          "[data-preview-content]",
        ) as HTMLElement | null;
        if (previewContent) {
          previewContent.style.width = "";
          previewContent.style.height = "";
          previewContent.style.flexShrink = "";
        }
        originalParent.insertBefore(card, placeholder);
        placeholder.remove();
        backdrop.remove();
        document.body.classList.remove("mk-card-fullscreen-open");
        document.body.style.paddingRight = "";
        gsap.set(card, { clearProps: "all" });
        fullscreenState = null;
      },
    });
  };

  const openFullscreenCard = (card: HTMLElement) => {
    if (fullscreenState) return;

    const scrollbarWidth =
      window.innerWidth - document.documentElement.clientWidth;
    document.body.style.paddingRight = `${scrollbarWidth}px`;
    document.body.classList.add("mk-card-fullscreen-open");

    const rect = card.getBoundingClientRect();
    const originalBorderRadius = getComputedStyle(card).borderRadius;

    const placeholder = document.createElement("div");
    placeholder.style.width = `${rect.width}px`;
    placeholder.style.height = `${rect.height}px`;
    placeholder.style.display = "block";
    placeholder.style.flexShrink = "0";

    const originalParent = card.parentNode;
    if (!originalParent) {
      document.body.classList.remove("mk-card-fullscreen-open");
      document.body.style.paddingRight = "";
      return;
    }

    const originalNext = card.nextSibling;
    originalParent.insertBefore(placeholder, card);

    const previewContent = card.querySelector(
      "[data-preview-content]",
    ) as HTMLElement | null;
    if (previewContent) {
      const previewRect = previewContent.getBoundingClientRect();
      previewContent.style.width = `${previewRect.width}px`;
      previewContent.style.height = `${previewRect.height}px`;
      previewContent.style.flexShrink = "0";
    }

    const backdrop = document.createElement("div");
    backdrop.className = "mk-card-fullscreen-backdrop";
    backdrop.setAttribute("data-card-backdrop", "");
    backdrop.style.opacity = "0";
    document.body.appendChild(backdrop);
    gsap.to(backdrop, { opacity: 1, duration: 0.25, ease: "power2.out" });

    card.dataset.fullscreenActive = "true";

    fullscreenState = {
      card,
      placeholder,
      backdrop,
      originalBorderRadius,
      originalParent,
      originalNext,
    };

    gsap.fromTo(
      card,
      {
        top: rect.top,
        left: rect.left,
        width: rect.width,
        height: rect.height,
        borderRadius: originalBorderRadius,
      },
      {
        top: 0,
        left: 0,
        width: window.innerWidth,
        height: window.innerHeight,
        borderRadius: 0,
        duration: 0.65,
        ease: "power3.inOut",
      },
    );
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeFullscreenCard();
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const replayButton = target.closest(
      "[data-card-action='replay']",
    ) as HTMLButtonElement | null;
    if (replayButton) {
      const card = replayButton.closest("[data-component-card]");
      if (card instanceof HTMLElement) replayPreview(card);
      return;
    }

    const copyButton = target.closest("[data-copy-text]") as
      | HTMLButtonElement
      | null;
    if (copyButton) {
      void copyText(copyButton);
      return;
    }

    if (window.getSelection()?.toString()) return;
    if (isIgnoredFullscreenTarget(event)) return;

    if (fullscreenState) {
      const card = target.closest("[data-component-card]") as HTMLElement | null;
      const backdrop = target.closest("[data-card-backdrop]");

      if (backdrop || card === fullscreenState.card) {
        closeFullscreenCard();
      }
      return;
    }

    const card = target.closest("[data-component-card]") as HTMLElement | null;
    if (!card) return;

    openFullscreenCard(card);
  });

  document.addEventListener("input", (event) => {
    const element = event.target as HTMLElement & {
      value?: unknown;
      dataset: DOMStringMap;
    };
    const attr = element.dataset?.attr;
    if (!attr) return;

    const card = element.closest("figure");
    const preview = card?.querySelector("[data-preview]");
    if (!preview) return;

    const target = preview.querySelector(element.dataset.target ?? "");
    if (!target) return;

    const value = String((element as any).value ?? "");
    target.setAttribute(attr, value);

    const valueElement = element
      .closest("label")
      ?.querySelector(".ctrl-val") as HTMLElement | null;
    if (valueElement) valueElement.textContent = value;
  });
</script>
