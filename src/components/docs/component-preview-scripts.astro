<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";
  import "@/registry/interaction/card-stack/card-stack-element.ts";
  import "@/registry/interaction/card-stack/card-stack-item-element.ts";
  import "@/registry/interaction/magnetic/magnetic-element.ts";
  import "@/registry/interaction/velocity-card/velocity-card-element.ts";
  import "@/registry/text/text-loop/text-loop-element.ts";
  import "@/registry/text/text-scramble/text-scramble-element.ts";
  import "@/registry/text/text-repel/text-repel-element.ts";
  import "@/registry/text/split-reveal/split-reveal-element.ts";
  import "@/registry/text/stacking-words/stacking-words-element.ts";
  import "@/registry/text/split-hover/split-hover-element.ts";
  import "@/registry/text/weight-wave/weight-wave-element.ts";
  import "@/registry/interaction/marquee/marquee-element.ts";
  import "@/registry/showcase/logo-carousel/logo-carousel-element.ts";
  import "@/registry/showcase/slideshow/slideshow-element.ts";
  import "@/registry/interaction/flip-card-stack/flip-card-stack-element.ts";
  import "@/registry/interaction/flip-grid/flip-grid-element.ts";
  import "@/registry/interaction/flip-grid/flip-grid-item-element.ts";
  import "@/registry/interaction/floating-menu/floating-menu-element.ts";
  import "@/registry/canvas/glass-slideshow/glass-slideshow-element.ts";
  import "@/registry/canvas/glitter-cloth/glitter-cloth-element.ts";
  import "@/registry/canvas/globe/globe-element.ts";
  import "@/registry/canvas/god-rays/god-rays-element.ts";
  import "@/registry/canvas/halo/halo-element.ts";
  import "@/registry/interaction/image-trail/image-trail-element.ts";
  import "@/registry/showcase/infinite-gallery/infinite-gallery-element.ts";
  import "@/registry/showcase/radial-gallery/radial-gallery-element.ts";
  import "@/registry/showcase/infinite-physics-gallery/infinite-physics-gallery-element.ts";
  import "@/registry/showcase/video-player/video-player-element.ts";
  import "@/registry/canvas/card-3d/card-3d-element.ts";
  import "@/registry/canvas/dithered-image/dithered-image-element.ts";
  import "@/registry/canvas/fake-3d-image/fake-3d-image-element.ts";
  import "@/registry/canvas/pixelated-image/pixelated-image-element.ts";
  import "@/registry/canvas/fluid-simulation/fluid-simulation-element.ts";
  import "@/registry/canvas/fluid-image-reveal/fluid-image-reveal-element.ts";
  import "@/registry/canvas/glass-logo/glass-logo-element.ts";
  import "@/registry/canvas/glass-pane/glass-pane-element.ts";
  import "@/registry/canvas/ascii-renderer/ascii-renderer-element.ts";
  import "@/registry/canvas/lava-lamp/lava-lamp-element.ts";
  import "@/registry/canvas/rubiks-cube/rubiks-cube-element.ts";
  import "@/registry/canvas/neural-noise/neural-noise-element.ts";
  import "@/registry/canvas/plasma-grid/plasma-grid-element.ts";
  import "@/registry/canvas/specular-band/specular-band-element.ts";
  import "@/registry/canvas/interactive-grid/interactive-grid-element.ts";
  import "@/registry/canvas/water-ripple/water-ripple-element.ts";
  import "@/components/ui/mk-slider.ts";
  import "@/components/ui/mk-color.ts";
  import "@/components/ui/mk-select.ts";
  import "@/components/ui/mk-text-input.ts";
  import "@/components/ui/mk-file-input.ts";

  gsap.registerPlugin(Flip);

  type FullscreenCardState = {
    card: HTMLElement;
    placeholder: HTMLDivElement;
    backdrop: HTMLDivElement;
    originalBorderRadius: string;
    originalParent: Node;
    originalNext: Node | null;
    controlsPanel: HTMLElement | null;
  };

  let fullscreenState: FullscreenCardState | null = null;
  let hoveredCard: HTMLElement | null = null;

  document.addEventListener("mouseover", (event) => {
    hoveredCard =
      (event.target as HTMLElement | null)?.closest("[data-component-card]") ??
      null;
  });

  const replayPreview = (card: HTMLElement) => {
    const preview = card.querySelector("[data-preview]");
    if (!preview) return;

    preview.querySelectorAll("*").forEach((element) => {
      if (typeof (element as any).replay === "function") {
        (element as any).replay();
      }
    });
  };

  const copyText = async (button: HTMLButtonElement) => {
    const text = button.dataset.copyText;
    if (!text) return;

    await navigator.clipboard.writeText(text);

    const original = button.textContent;
    button.textContent = "Copied!";
    window.setTimeout(() => {
      button.textContent = original;
    }, 1800);
  };

  const getControlTarget = (control: HTMLElement) => {
    const card = control.closest("figure");
    const preview = card?.querySelector("[data-preview]");
    if (!preview) return null;
    return preview.querySelector(control.dataset.target ?? "");
  };

  const applyControlValue = (control: HTMLElement) => {
    const attr = control.dataset.attr;
    if (!attr) return;

    const target = getControlTarget(control);
    if (!target) return;

    const value = String((control as any).value ?? "");
    target.setAttribute(attr, value);
  };

  const getDefaultControlValue = (control: HTMLElement) => {
    if (control.tagName === "MK-SLIDER") {
      const defaultValue = control.getAttribute("value");
      return defaultValue === null ? null : Number(defaultValue);
    }

    if (control.tagName === "MK-COLOR") {
      return control.getAttribute("value");
    }

    if (control.tagName === "MK-SELECT") {
      const selectedOption = control.querySelector(
        "option[selected]",
      ) as HTMLOptionElement | null;
      const firstOption = control.querySelector("option");
      if (selectedOption?.value) return selectedOption.value;
      if (firstOption?.value) return firstOption.value;

      // Try parsing from options attribute
      const optionsAttr = control.getAttribute("options");
      if (optionsAttr) {
        try {
          const parsed = JSON.parse(optionsAttr);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return typeof parsed[0] === "string"
              ? parsed[0]
              : (parsed[0]?.value ?? null);
          }
        } catch (e) {
          // Invalid JSON, ignore
        }
      }
      return null;
    }

    if (control.tagName === "MK-TEXT-INPUT") {
      return control.getAttribute("value") ?? "";
    }

    if (control.tagName === "MK-FILE-INPUT") {
      return null;
    }

    return (control as HTMLInputElement).defaultValue ?? null;
  };

  const resetPreviewProps = (card: HTMLElement) => {
    const controls = card.querySelectorAll("[data-attr]");

    controls.forEach((control) => {
      if (!(control instanceof HTMLElement)) return;

      const defaultValue = getDefaultControlValue(control);
      if (defaultValue === null) return;

      (control as any).value = defaultValue;
      control.dispatchEvent(
        new Event("input", { bubbles: true, composed: true }),
      );
    });
  };

  const closeFullscreenCard = () => {
    const state = fullscreenState;
    if (!state) return;

    const {
      card,
      placeholder,
      backdrop,
      originalBorderRadius,
      originalParent,
      controlsPanel,
    } = state;

    const targetRect = placeholder.getBoundingClientRect();

    gsap.to(backdrop, { opacity: 0, duration: 0.3, ease: "power2.out" });

    if (controlsPanel) {
      gsap.to(controlsPanel, {
        x: 16,
        opacity: 0,
        scale: 0.94,
        duration: 0.2,
        ease: "back.in(2)",
        onComplete: () => {
          gsap.set(controlsPanel, { clearProps: "all" });
          delete controlsPanel.dataset.fullscreenPanel;
          const controlsBody = controlsPanel.querySelector(
            "[data-controls-body]",
          ) as HTMLElement | null;
          if (controlsBody) {
            gsap.set(controlsBody, { height: 0 });
            gsap.to(controlsBody, {
              height: "auto",
              duration: 0.4,
              ease: "power3.out",
              onComplete: () => gsap.set(controlsBody, { clearProps: "height" }),
            });
          }
        },
      });
    }

    gsap.to(card, {
      top: targetRect.top,
      left: targetRect.left,
      width: targetRect.width,
      height: targetRect.height,
      borderRadius: originalBorderRadius,
      duration: 0.55,
      ease: "power3.inOut",
      onComplete: () => {
        card.dataset.fullscreenActive = "false";
        const previewContent = card.querySelector(
          "[data-preview-content]",
        ) as HTMLElement | null;
        if (previewContent) {
          previewContent.style.width = "";
          previewContent.style.height = "";
          previewContent.style.flexShrink = "";
        }
        placeholder.remove();
        backdrop.remove();
        document.body.classList.remove("mk-card-fullscreen-open");
        document.body.style.paddingRight = "";
        gsap.set(card, { clearProps: "all" });
        fullscreenState = null;
      },
    });
  };

  const openFullscreenCard = (card: HTMLElement) => {
    if (fullscreenState) return;

    const scrollbarWidth =
      window.innerWidth - document.documentElement.clientWidth;
    document.body.style.paddingRight = `${scrollbarWidth}px`;
    document.body.classList.add("mk-card-fullscreen-open");

    const rect = card.getBoundingClientRect();
    const originalBorderRadius = getComputedStyle(card).borderRadius;

    const placeholder = document.createElement("div");
    placeholder.style.width = `${rect.width}px`;
    placeholder.style.height = `${rect.height}px`;
    placeholder.style.display = "block";
    placeholder.style.flexShrink = "0";

    const originalParent = card.parentNode;
    if (!originalParent) {
      document.body.classList.remove("mk-card-fullscreen-open");
      document.body.style.paddingRight = "";
      return;
    }

    const originalNext = card.nextSibling;
    originalParent.insertBefore(placeholder, card);

    const previewContent = card.querySelector(
      "[data-preview-content]",
    ) as HTMLElement | null;
    if (previewContent) {
      const previewRect = previewContent.getBoundingClientRect();
      previewContent.style.width = `${previewRect.width}px`;
      previewContent.style.height = `${previewRect.height}px`;
      previewContent.style.flexShrink = "0";
    }

    const backdrop = document.createElement("div");
    backdrop.className = "mk-card-fullscreen-backdrop";
    backdrop.setAttribute("data-card-backdrop", "");
    backdrop.style.opacity = "0";
    document.body.appendChild(backdrop);
    gsap.to(backdrop, { opacity: 1, duration: 0.25, ease: "power2.out" });

    card.dataset.fullscreenActive = "true";

    const controlsPanel = card.querySelector(
      "[data-controls-panel]",
    ) as HTMLElement | null;

    fullscreenState = {
      card,
      placeholder,
      backdrop,
      originalBorderRadius,
      originalParent,
      originalNext,
      controlsPanel,
    };

    if (controlsPanel) {
      const controlsBody = controlsPanel.querySelector(
        "[data-controls-body]",
      ) as HTMLElement | null;
      if (controlsBody) {
        gsap.to(controlsBody, {
          height: 0,
          duration: 0.35,
          ease: "power3.in",
        });
      }
    }

    gsap.fromTo(
      card,
      {
        top: rect.top,
        left: rect.left,
        width: rect.width,
        height: rect.height,
        borderRadius: originalBorderRadius,
      },
      {
        top: 0,
        left: 0,
        width: window.innerWidth,
        height: window.innerHeight,
        borderRadius: 0,
        duration: 0.65,
        ease: "power3.inOut",
        onComplete: () => {
          if (!controlsPanel) return;
          const controlsBody = controlsPanel.querySelector(
            "[data-controls-body]",
          ) as HTMLElement | null;
          if (controlsBody) gsap.set(controlsBody, { clearProps: "height" });
          controlsPanel.dataset.fullscreenPanel = "true";
          gsap.set(controlsPanel, {
            position: "absolute",
            top: 48,
            right: 12,
            bottom: "auto",
            left: "auto",
            width: 284,
            y: 0,
            x: 20,
            opacity: 0,
            scale: 0.94,
            transformOrigin: "right top",
            zIndex: 15,
          });
          gsap.to(controlsPanel, {
            x: 0,
            opacity: 1,
            scale: 1,
            duration: 0.55,
            ease: "back.out(2.4)",
          });
        },
      },
    );
  };

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeFullscreenCard();
    } else if (event.key === "f" || event.key === "F") {
      const typing = event.composedPath().some((node) => {
        if (!(node instanceof HTMLElement)) return false;
        return (
          node.tagName === "INPUT" ||
          node.tagName === "TEXTAREA" ||
          node.tagName === "SELECT" ||
          node.isContentEditable ||
          node.getAttribute("role") === "textbox"
        );
      });
      if (typing) return;

      if (fullscreenState) {
        closeFullscreenCard();
      } else if (hoveredCard) {
        openFullscreenCard(hoveredCard);
      }
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const replayButton = target.closest("[data-card-action='replay']");
    if (replayButton) {
      const card = replayButton.closest("[data-component-card]");
      if (card instanceof HTMLElement) replayPreview(card);
      return;
    }

    const resetPropsButton = target.closest("[data-card-action='reset-props']");
    if (resetPropsButton) {
      const card = resetPropsButton.closest("[data-component-card]");
      if (card instanceof HTMLElement) resetPreviewProps(card);
      return;
    }

    const copyButton = target.closest(
      "[data-copy-text]",
    ) as HTMLButtonElement | null;
    if (copyButton) {
      void copyText(copyButton);
      return;
    }

    const fullscreenButton = target.closest("[data-card-action='fullscreen']");
    if (fullscreenButton) {
      const card = fullscreenButton.closest("[data-component-card]");
      if (card instanceof HTMLElement) {
        if (fullscreenState?.card === card) {
          closeFullscreenCard();
        } else {
          openFullscreenCard(card);
        }
      }
      return;
    }

    if (target.closest("[data-card-backdrop]")) {
      closeFullscreenCard();
    }
  });

  document.addEventListener("input", (event) => {
    const element = event.target as HTMLElement & {
      value?: unknown;
      dataset: DOMStringMap;
    };
    if (!element.dataset?.attr) return;
    applyControlValue(element);
  });
</script>
