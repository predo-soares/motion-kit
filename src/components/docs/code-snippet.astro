---
interface Props {
  code: string;
  label?: string;
}

const { code, label } = Astro.props;
---

<div class="w-full min-w-0 overflow-hidden rounded-3xl border border-slate-200 bg-slate-50">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
    <div class="flex items-center gap-2">
      {label ? <span class="text-sm font-medium text-slate-700">{label}</span> : null}
    </div>
    <button
      type="button"
      data-copy-text={code}
      class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900"
      aria-label="Copy code"
    >
      Copy
    </button>
  </div>
  <pre class="w-full min-w-0 overflow-x-auto px-4 py-4 text-[13px] leading-6 text-slate-800"><code>{code}</code></pre>
</div>
