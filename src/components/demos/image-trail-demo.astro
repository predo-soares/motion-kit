---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="Move the pointer through the frame to emit an image trail with pooled GSAP animations.">
  <div class="relative h-[420px] w-full overflow-hidden rounded-[2rem]">
    <motion-image-trail
      images='["https://picsum.photos/seed/it1/120/120","https://picsum.photos/seed/it2/120/120","https://picsum.photos/seed/it3/120/120","https://picsum.photos/seed/it4/120/120","https://picsum.photos/seed/it5/120/120"]'
      class="absolute inset-0"
    ></motion-image-trail>
  </div>
</ComponentCard>
