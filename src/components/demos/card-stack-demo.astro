---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard
  description="Scroll-driven sticky card stack with GSAP ScrollTrigger. Scroll inside the preview to see the effect."
  scrollable
  id="card-stack-preview"
>
  <div
    class="flex items-center justify-center h-[440px] border-b border-slate-100"
  >
    <p class="text-slate-400 text-sm tracking-wide">↓ Scroll to reveal</p>
  </div>
  <motion-card-stack
    id="card-stack-main"
    scale-factor="0.06"
    gap="24"
    offset="8"
    top-offset="32"
    scroll-element="#card-stack-preview"
    class="p-16 pt-20"
  >
    <motion-card-stack-item
      class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm min-h-[320px] gap-3"
    >
      <span class="text-xs font-bold tracking-widest uppercase text-orange-500">
        01
      </span>
      <h2 class="text-2xl font-bold text-slate-900 leading-tight">
        Pure Custom Elements
      </h2>
      <p class="text-slate-500 leading-relaxed max-w-prose">
        Ship as <code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded"
          >.ts</code
        >
        files from a shadcn-compatible registry. Drop them into any HTML, React, or
        Vue project.
      </p>
    </motion-card-stack-item>
    <motion-card-stack-item
      class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm min-h-[320px] gap-3"
    >
      <span class="text-xs font-bold tracking-widest uppercase text-violet-500">
        02
      </span>
      <h2 class="text-2xl font-bold text-slate-900 leading-tight">
        GSAP-powered motion
      </h2>
      <p class="text-slate-500 leading-relaxed max-w-prose">
        Each card pins, then scales as the next one slides in, driven by
        ScrollTrigger scrub.
      </p>
    </motion-card-stack-item>
    <motion-card-stack-item
      class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm min-h-[320px] gap-3"
    >
      <span class="text-xs font-bold tracking-widest uppercase text-sky-500">
        03
      </span>
      <h2 class="text-2xl font-bold text-slate-900 leading-tight">
        Lit under the hood
      </h2>
      <p class="text-slate-500 leading-relaxed max-w-prose">
        Framework-agnostic web components via
        <code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded"
          >LitElement</code
        >. Shadow DOM keeps styles and GSAP logic fully encapsulated.
      </p>
    </motion-card-stack-item>
  </motion-card-stack>
  <div
    class="flex items-center justify-center h-[440px] border-b border-slate-100"
  >
    <p class="text-slate-400 text-sm tracking-wide">Hell yeah!</p>
  </div>

  <div slot="controls" class="mk-controls">
    <mk-slider
      label="Scale Factor"
      min="0.01"
      max="0.15"
      step="0.01"
      value="0.06"
      data-target="#card-stack-main"
      data-attr="scale-factor"></mk-slider>
    <mk-slider
      label="Gap"
      min="0"
      max="64"
      step="4"
      value="24"
      data-target="#card-stack-main"
      data-attr="gap"></mk-slider>
    <mk-slider
      label="Offset"
      min="0"
      max="32"
      step="1"
      value="8"
      data-target="#card-stack-main"
      data-attr="offset"></mk-slider>
    <mk-slider
      label="Top Offset"
      min="0"
      max="100"
      step="4"
      value="32"
      data-target="#card-stack-main"
      data-attr="top-offset"></mk-slider>
  </div>
</ComponentCard>
