---
import ComponentCard from "@/components/ui/component-card.astro";

const images = [
  { src: "/images/demos/sample-8.jpg", id: "img-0" },
  { src: "/images/demos/sample-9.jpg", id: "img-1" },
  { src: "/images/demos/sample-10.jpg", id: "img-2" },
  { src: "/images/demos/sample-11.jpg", id: "img-3" },
];
---

<ComponentCard
  description="GSAP FLIP grid — change columns or animation settings to see items smoothly transition between layout states."
>
  <div class="p-4 w-full h-[400px] overflow-y-auto">
    <motion-flip-grid
      id="flip-grid-main"
      columns="4"
      gap="1rem"
      duration="0.5"
      ease="power2.inOut"
      stagger="0.1"
      class="w-full"
    >
      {
        images.map(({ src, id }) => (
          <motion-flip-grid-item
            flip-id={id}
            class="relative aspect-square w-full overflow-hidden rounded-lg shadow-md"
          >
            <img
              src={src}
              alt=""
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </motion-flip-grid-item>
        ))
      }
    </motion-flip-grid>
  </div>

  <div slot="controls" class="mk-controls">
    <mk-select
      label="Columns"
      data-target="#flip-grid-main"
      data-attr="columns"
    >
      <option value="1">1</option>
      <option value="2">2</option>
      <option value="3">3</option>
      <option value="4" selected>4</option>
    </mk-select>
    <mk-slider
      label="Duration"
      min="0.1"
      max="2"
      step="0.05"
      value="0.5"
      data-target="#flip-grid-main"
      data-attr="duration"></mk-slider>
    <mk-slider
      label="Stagger"
      min="0"
      max="0.3"
      step="0.01"
      value="0.1"
      data-target="#flip-grid-main"
      data-attr="stagger"></mk-slider>
    <mk-select label="Ease" data-target="#flip-grid-main" data-attr="ease">
      <option value="power1.inOut">power1.inOut</option>
      <option value="power2.inOut" selected>power2.inOut</option>
      <option value="power3.inOut">power3.inOut</option>
      <option value="power4.inOut">power4.inOut</option>
      <option value="elastic.out(1,0.3)">elastic.out</option>
      <option value="back.inOut(1.7)">back.inOut</option>
      <option value="bounce.out">bounce.out</option>
    </mk-select>
  </div>
</ComponentCard>
