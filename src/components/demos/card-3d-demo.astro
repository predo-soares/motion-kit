---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="OGL-powered 3D card with rounded corners. Move your cursor over it to rotate.">
  <div class="relative h-[420px] w-full overflow-hidden rounded-[2rem]">
    <motion-card-3d
      image="https://picsum.photos/seed/card3d/720/440"
      width="3.2"
      height="2"
      depth="0.08"
      radius="0.15"
      class="absolute inset-0"
    ></motion-card-3d>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-slider
      label="Depth"
      min="0.01"
      max="0.3"
      step="0.01"
      value="0.08"
      data-target="motion-card-3d"
      data-attr="depth"
    ></mk-slider>
    <mk-slider
      label="Radius"
      min="0"
      max="0.45"
      step="0.01"
      value="0.15"
      data-target="motion-card-3d"
      data-attr="radius"
    ></mk-slider>
  </div>
</ComponentCard>
