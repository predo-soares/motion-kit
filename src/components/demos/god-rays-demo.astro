---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="Procedural crepuscular rays with color, spread, distortion, and pulsation controls.">
  <div class="relative aspect-video w-full overflow-hidden rounded-[2rem] bg-[#17181A]">
    <motion-god-rays
      color="#fff4dd"
      background-color="#0f1115"
      anchor-x="0.5"
      anchor-y="1.18"
      direction-x="0"
      direction-y="-1"
      speed="0.9"
      light-spread="0.8"
      ray-length="1.15"
      fade-distance="1.2"
      saturation="1"
      distortion="0"
      intensity="1.15"
      class="absolute inset-0"
    ></motion-god-rays>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-color
      label="Color"
      value="#fff4dd"
      data-target="motion-god-rays"
      data-attr="color"
    ></mk-color>
    <mk-color
      label="Background"
      value="#0f1115"
      data-target="motion-god-rays"
      data-attr="background-color"
    ></mk-color>
    <mk-slider
      label="Speed"
      min="0"
      max="2.5"
      step="0.05"
      value="0.9"
      data-target="motion-god-rays"
      data-attr="speed"
    ></mk-slider>
    <mk-slider
      label="Spread"
      min="0.2"
      max="2.5"
      step="0.05"
      value="0.8"
      data-target="motion-god-rays"
      data-attr="light-spread"
    ></mk-slider>
    <mk-slider
      label="Length"
      min="0.3"
      max="2"
      step="0.05"
      value="1.15"
      data-target="motion-god-rays"
      data-attr="ray-length"
    ></mk-slider>
    <mk-slider
      label="Distortion"
      min="0"
      max="1"
      step="0.02"
      value="0"
      data-target="motion-god-rays"
      data-attr="distortion"
    ></mk-slider>
    <mk-slider
      label="Intensity"
      min="0"
      max="2"
      step="0.05"
      value="1.15"
      data-target="motion-god-rays"
      data-attr="intensity"
    ></mk-slider>
  </div>
</ComponentCard>
