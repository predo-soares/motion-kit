---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="Move your cursor over the text to shift font weight with a smooth falloff. Requires a variable font.">
  <div class="flex flex-col items-center justify-center gap-6 py-12">
    <motion-weight-wave
      text="Weight Wave"
      base-weight="200"
      hover-weight="900"
      influence-radius="3"
      class="text-5xl tracking-tight text-slate-900 cursor-default select-none"
    ></motion-weight-wave>
    <motion-weight-wave
      text="Move your cursor here"
      base-weight="300"
      hover-weight="800"
      influence-radius="4"
      falloff-power="2"
      class="text-2xl tracking-wide text-violet-600 cursor-default select-none"
    ></motion-weight-wave>
  </div>
</ComponentCard>
