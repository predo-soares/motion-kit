---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="WebGL dithered image with Bayer, halftone, and void-and-cluster threshold maps.">
  <div class="relative aspect-video w-full overflow-hidden rounded-[2rem]">
    <motion-dithered-image
      id="dither-main"
      image="https://picsum.photos/seed/dither1/600/400"
      dither-map="bayer4x4"
      color="#ff6900"
      background-color="#17181A"
      pixel-size="1"
      class="absolute inset-0"
    ></motion-dithered-image>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-select
      label="Map"
      data-target="#dither-main"
      data-attr="dither-map"
    >
      <option value="bayer4x4" selected>Bayer 4×4</option>
      <option value="bayer8x8">Bayer 8×8</option>
      <option value="halftone">Halftone</option>
      <option value="voidAndCluster">Void & Cluster</option>
    </mk-select>
    <mk-slider
      label="Pixels"
      min="1"
      max="8"
      step="1"
      value="1"
      data-target="#dither-main"
      data-attr="pixel-size"
    ></mk-slider>
    <mk-slider
      label="Threshold"
      min="-0.5"
      max="0.5"
      step="0.02"
      value="0"
      data-target="#dither-main"
      data-attr="threshold"
    ></mk-slider>
    <mk-color
      label="Color"
      value="#ff6900"
      data-target="#dither-main"
      data-attr="color"
    ></mk-color>
    <mk-color
      label="Background"
      value="#17181a"
      data-target="#dither-main"
      data-attr="background-color"
    ></mk-color>
  </div>
</ComponentCard>
