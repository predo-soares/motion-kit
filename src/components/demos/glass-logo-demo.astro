---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="WebGL2 glass lens over an animated procedural swirl. The silhouette is driven by an inline SVG.">
  <div class="relative h-[420px] w-full overflow-hidden rounded-[2rem] bg-[#17181A]">
    <motion-glass-logo
      speed="1"
      scale="1"
      refraction="1"
      chromatic-aberration="1"
      blur="1"
      swirl-color-a="#222326"
      swirl-color-b="#ff6900"
      class="absolute inset-0"
    ></motion-glass-logo>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-slider
      label="Speed"
      min="0"
      max="3"
      step="0.1"
      value="1"
      data-target="motion-glass-logo"
      data-attr="speed"
    ></mk-slider>
    <mk-slider
      label="Scale"
      min="0.3"
      max="3"
      step="0.1"
      value="1"
      data-target="motion-glass-logo"
      data-attr="scale"
    ></mk-slider>
    <mk-slider
      label="Refraction"
      min="0"
      max="3"
      step="0.1"
      value="1"
      data-target="motion-glass-logo"
      data-attr="refraction"
    ></mk-slider>
    <mk-slider
      label="CA"
      min="0"
      max="3"
      step="0.1"
      value="1"
      data-target="motion-glass-logo"
      data-attr="chromatic-aberration"
    ></mk-slider>
    <mk-slider
      label="Blur"
      min="0"
      max="3"
      step="0.1"
      value="1"
      data-target="motion-glass-logo"
      data-attr="blur"
    ></mk-slider>
    <mk-color
      label="Background"
      value="#222326"
      data-target="motion-glass-logo"
      data-attr="swirl-color-a"
    ></mk-color>
    <mk-color
      label="Accent"
      value="#ff6900"
      data-target="motion-glass-logo"
      data-attr="swirl-color-b"
    ></mk-color>
  </div>
</ComponentCard>
