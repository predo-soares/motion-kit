---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="Masks text and reveals lines, words, or characters on mount or scroll.">
  <div class="flex flex-col items-center justify-center gap-4 p-8">
    <div>
      <motion-split-reveal
        text="Lines reveal upward from a mask."
        mode="lines"
        class="text-2xl font-bold text-slate-900"
        delay="0.1"
      ></motion-split-reveal>
      <motion-split-reveal
        text="Words arrive one by one in sequence."
        mode="words"
        class="text-2xl font-bold text-slate-600"
        delay="0.4"
      ></motion-split-reveal>
      <motion-split-reveal
        text="CHARS"
        mode="chars"
        class="text-5xl font-black tracking-widest text-violet-600"
        delay="0.8"
      ></motion-split-reveal>
    </div>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-text-input
      label="Text 1"
      value="Lines reveal upward from a mask."
      data-target="motion-split-reveal"
      data-index="0"
      data-attr="text"
    ></mk-text-input>
    <mk-select
      label="Mode 1"
      value="lines"
      data-target="motion-split-reveal"
      data-index="0"
      data-attr="mode"
      options='["lines","words","chars"]'
    ></mk-select>
    <mk-slider
      label="Delay 1"
      min="0"
      max="2"
      step="0.1"
      value="0.1"
      data-target="motion-split-reveal"
      data-index="0"
      data-attr="delay"
    ></mk-slider>
    <mk-text-input
      label="Text 2"
      value="Words arrive one by one in sequence."
      data-target="motion-split-reveal"
      data-index="1"
      data-attr="text"
    ></mk-text-input>
    <mk-select
      label="Mode 2"
      value="words"
      data-target="motion-split-reveal"
      data-index="1"
      data-attr="mode"
      options='["lines","words","chars"]'
    ></mk-select>
    <mk-slider
      label="Delay 2"
      min="0"
      max="2"
      step="0.1"
      value="0.4"
      data-target="motion-split-reveal"
      data-index="1"
      data-attr="delay"
    ></mk-slider>
    <mk-text-input
      label="Text 3"
      value="CHARS"
      data-target="motion-split-reveal"
      data-index="2"
      data-attr="text"
    ></mk-text-input>
    <mk-select
      label="Mode 3"
      value="chars"
      data-target="motion-split-reveal"
      data-index="2"
      data-attr="mode"
      options='["lines","words","chars"]'
    ></mk-select>
    <mk-slider
      label="Delay 3"
      min="0"
      max="2"
      step="0.1"
      value="0.8"
      data-target="motion-split-reveal"
      data-index="2"
      data-attr="delay"
    ></mk-slider>
  </div>
</ComponentCard>
