---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="Characters split into two stacked layers that swap on hover.">
  <div class="flex items-center justify-center gap-10 py-12">
    <motion-split-hover
      text="Hover me"
      class="text-4xl font-bold text-slate-900 cursor-default select-none"
    ></motion-split-hover>
    <motion-split-hover
      text="Motion Blocks"
      class="text-4xl font-bold text-violet-600 cursor-default select-none"
    ></motion-split-hover>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-text-input
      label="Text 1"
      value="Hover me"
      data-target="motion-split-hover"
      data-index="0"
      data-attr="text"
    ></mk-text-input>
    <mk-text-input
      label="Text 2"
      value="Motion Blocks"
      data-target="motion-split-hover"
      data-index="1"
      data-attr="text"
    ></mk-text-input>
  </div>
</ComponentCard>
