---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="An animated shader field for silky fabric folds with glitter highlights and a subtle vignette.">
  <motion-glitter-cloth
    id="glitter-cloth-main"
    class="block h-[420px] w-full overflow-hidden rounded-[2rem]"
    color="#222326"
    speed="1"
    brightness="1"
    blend-strength="0.02"
    noise-scale="4"
    vignette-strength="50"
    vignette-power="0.5"
    vignette-opacity="1"
  ></motion-glitter-cloth>
  <div slot="controls" class="mk-controls">
    <mk-color
      label="Color"
      value="#222326"
      data-target="#glitter-cloth-main"
      data-attr="color"
    ></mk-color>
    <mk-slider
      label="Speed"
      min="0"
      max="3"
      step="0.05"
      value="1"
      data-target="#glitter-cloth-main"
      data-attr="speed"
    ></mk-slider>
    <mk-slider
      label="Brightness"
      min="0.2"
      max="2"
      step="0.05"
      value="1"
      data-target="#glitter-cloth-main"
      data-attr="brightness"
    ></mk-slider>
    <mk-slider
      label="Blend"
      min="0"
      max="0.08"
      step="0.002"
      value="0.02"
      data-target="#glitter-cloth-main"
      data-attr="blend-strength"
    ></mk-slider>
    <mk-slider
      label="Noise"
      min="1"
      max="8"
      step="0.1"
      value="4"
      data-target="#glitter-cloth-main"
      data-attr="noise-scale"
    ></mk-slider>
    <mk-slider
      label="Vignette"
      min="0"
      max="60"
      step="0.5"
      value="50"
      data-target="#glitter-cloth-main"
      data-attr="vignette-strength"
    ></mk-slider>
    <mk-slider
      label="Vignette Pow"
      min="0.1"
      max="3"
      step="0.05"
      value="0.5"
      data-target="#glitter-cloth-main"
      data-attr="vignette-power"
    ></mk-slider>
    <mk-slider
      label="Vignette Op"
      min="0"
      max="1"
      step="0.05"
      value="1"
      data-target="#glitter-cloth-main"
      data-attr="vignette-opacity"
    ></mk-slider>
  </div>
</ComponentCard>
