---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="Animated specular band effect with lens distortion — flowing organic light bands with hue-shifted color palettes and adaptive brightness blending.">
  <div class="relative aspect-video w-full overflow-hidden rounded-[2rem] bg-[#17181A]">
    <motion-specular-band
      color="#6c87bc"
      background-color="#17181A"
      speed="0.8"
      distortion="0.2"
      hue-shift="30"
      intensity="1"
      class="absolute inset-0"
    ></motion-specular-band>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-slider
      label="Speed"
      min="0"
      max="3"
      step="0.05"
      value="0.8"
      data-target="motion-specular-band"
      data-attr="speed"
    ></mk-slider>
    <mk-slider
      label="Distortion"
      min="0"
      max="0.5"
      step="0.01"
      value="0.2"
      data-target="motion-specular-band"
      data-attr="distortion"
    ></mk-slider>
    <mk-slider
      label="Hue Shift"
      min="0"
      max="90"
      step="1"
      value="30"
      data-target="motion-specular-band"
      data-attr="hue-shift"
    ></mk-slider>
    <mk-slider
      label="Intensity"
      min="0"
      max="2"
      step="0.05"
      value="1"
      data-target="motion-specular-band"
      data-attr="intensity"
    ></mk-slider>
    <mk-color
      label="Color"
      value="#6c87bc"
      data-target="motion-specular-band"
      data-attr="color"
    ></mk-color>
    <mk-color
      label="Background"
      value="#17181A"
      data-target="motion-specular-band"
      data-attr="background-color"
    ></mk-color>
  </div>
</ComponentCard>
