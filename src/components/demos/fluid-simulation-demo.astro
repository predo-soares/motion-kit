---
import ComponentCard from "@/components/ui/component-card.astro";
---

<ComponentCard description="GPU fluid simulation. Move the cursor to paint fluid while the scene animates autonomously when idle.">
  <div class="relative aspect-video w-full overflow-hidden rounded-[2rem] bg-[#17181A]">
    <motion-fluid-simulation
      color="#ff6900"
      background-color="#17181a"
      dissipation="0.96"
      pointer-size="0.005"
      pressure-iterations="10"
      class="absolute inset-0"
    ></motion-fluid-simulation>
  </div>
  <div slot="controls" class="mk-controls">
    <mk-slider
      label="Dissipation"
      min="0.8"
      max="1"
      step="0.005"
      value="0.96"
      data-target="motion-fluid-simulation"
      data-attr="dissipation"
    ></mk-slider>
    <mk-slider
      label="Splat Size"
      min="0.001"
      max="0.025"
      step="0.001"
      value="0.005"
      data-target="motion-fluid-simulation"
      data-attr="pointer-size"
    ></mk-slider>
    <mk-color
      label="Color"
      value="#ff6900"
      data-target="motion-fluid-simulation"
      data-attr="color"
    ></mk-color>
    <mk-color
      label="Background"
      value="#17181a"
      data-target="motion-fluid-simulation"
      data-attr="background-color"
    ></mk-color>
  </div>
</ComponentCard>
