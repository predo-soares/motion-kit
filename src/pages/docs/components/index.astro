---
import ComponentBrowserShell from "@/components/docs/component-browser-shell.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { componentCatalog } from "@/lib/catalog";

const sorted = [...componentCatalog].sort((a, b) =>
  a.title.localeCompare(b.title),
);
---

<SiteLayout
  title="Components — Motion Blocks"
  description="Browse all animated web components in the Motion Blocks registry."
>
  <ComponentBrowserShell currentHref="/docs/components">
    <article class="flex w-full max-w-[600px] min-w-0 flex-col gap-10 pb-16">
      <header class="flex flex-col gap-3">
        <div class="flex flex-col gap-2">
          <p class="text-xs font-semibold text-slate-400">Docs</p>
          <h1 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">
            Components
          </h1>
        </div>
        <p class="max-w-3xl text-sm text-balance text-slate-600">
          All animated web components available in the registry, sorted alphabetically.
        </p>
      </header>

      <ul class="grid grid-cols-3 gap-x-4 gap-y-1">
        {
          sorted.map((component) => (
            <li>
              <a
                href={`/docs/components/${component.slug}`}
                class="block rounded-md py-1 text-sm text-slate-600 transition-colors hover:text-slate-950"
              >
                {component.title}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </ComponentBrowserShell>
</SiteLayout>
