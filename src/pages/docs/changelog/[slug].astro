---
import { render } from "astro:content";

import ComponentBrowserShell from "@/components/docs/component-browser-shell.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import {
  formatChangelogDate,
  getChangelogEntries,
} from "@/lib/changelog";

export async function getStaticPaths() {
  const entries = await getChangelogEntries();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout
  title={`${entry.data.title} — Motion Blocks`}
  description={entry.data.description}
>
  <ComponentBrowserShell currentHref="/docs/changelog">
    <article class="flex w-full max-w-[600px] min-w-0 flex-col gap-8 pb-16">
      <header class="flex flex-col gap-3">
        <a
          href="/docs/changelog"
          class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900"
        >
          Back to Changelog
        </a>
        <div class="flex flex-col gap-2">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">
            {formatChangelogDate(entry.data.date)}
          </p>
          <h1 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">
            {entry.data.title}
          </h1>
        </div>
        <p class="max-w-3xl text-sm text-balance text-slate-600">
          {entry.data.description}
        </p>
      </header>

      <div class="flex flex-col gap-4 text-sm leading-7 text-slate-700 [&_h2]:mt-4 [&_h2]:text-base [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-slate-950 [&_p]:m-0 [&_ul]:m-0 [&_ul]:pl-5 [&_ul]:space-y-2 [&_li]:pl-1 [&_code]:rounded [&_code]:bg-slate-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.9em]">
        <Content />
      </div>
    </article>
  </ComponentBrowserShell>
</SiteLayout>
