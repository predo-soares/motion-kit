---
import ComponentBrowserShell from "@/components/docs/component-browser-shell.astro";
import ComponentToc from "@/components/docs/component-toc.astro";
import CardLink from "@/components/docs/card-link.astro";
import CodeBlock from "@/components/docs/code-block.astro";
import PackageCommand from "@/components/docs/package-command.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import AstroLogo from "@/components/ui/logos/astro-logo.astro";
import NextJsLogo from "@/components/ui/logos/nextjs-logo.astro";
import SvelteLogo from "@/components/ui/logos/svelte-logo.astro";
import VueLogo from "@/components/ui/logos/vue-logo.astro";
import ReactLogo from "@/components/ui/logos/react-logo.astro";
import JavaScriptLogo from "@/components/ui/logos/javascript-logo.astro";

const tocItems = [
  { href: "#quick-start", label: "Quick Start" },
  { href: "#cli-commands", label: "CLI Commands" },
  { href: "#configuration", label: "Configuration" },
  { href: "#project-structure", label: "Project Structure" },
  { href: "#frameworks", label: "Framework Support" },
  { href: "#troubleshooting", label: "Troubleshooting" },
];

const motionKitConfig = `{
  "$schema": "https://motionkit.org/schemas/motion-blocks.json",
  "registry": "https://motionkit.org/r",
  "framework": "astro",
  "packageManager": "pnpm",
  "componentsDir": "src/components/motion-blocks",
  "helpersDir": "src/lib/motion-blocks"
}`;
const tsconfigDecorators = `{
  "compilerOptions": {
    "experimentalDecorators": true
  }
}`;
const importExample = `import "./magnetic-element";

// The component registers itself automatically.
// Use it in your HTML:
<motion-magnetic></motion-magnetic>`;
const projectStructure = `src/
├── components/
│   └── motion-blocks/          # Motion Blocks components
│       ├── magnetic/
│       │   └── magnetic-element.ts
│       ├── card-stack/
│       │   └── card-stack-element.ts
│       └── ...
├── lib/
│   └── motion-blocks/           # Shared helpers (e.g. gsap)
└── pages/`;
---

<SiteLayout
  title="Installation — Motion Blocks"
  description="How to install Motion Blocks components with the motion-blocks CLI."
>
  <ComponentBrowserShell currentHref="/docs/installation">
    <article class="flex w-full max-w-[600px] min-w-0 flex-col gap-10 pb-16">
      <header class="flex flex-col gap-3">
        <div class="flex flex-col gap-2">
          <p class="text-xs font-semibold text-slate-400">Docs</p>
          <h1
            class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl"
          >
            Installation
          </h1>
        </div>
        <p class="text-sm leading-6 text-balance text-slate-600">
          Install animated Web Components into your project with the Motion Blocks
          CLI. Motion Blocks uses <code
            class="rounded bg-slate-100 px-1.5 py-0.5 text-[0.9em] text-slate-800"
            >motion-blocks.json</code
          > only.
        </p>
      </header>

      <section id="quick-start" class="flex flex-col gap-4 scroll-mt-24">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">
          Quick Start
        </h2>
        <div class="flex flex-col gap-3 text-sm leading-7 text-slate-600">
          <p>
            Initialize Motion Blocks in your project, then add any component by
            name:
          </p>

          <PackageCommand command="motion-blocks init" />
          <PackageCommand command="motion-blocks add magnetic" />

          <p>The CLI will automatically:</p>
          <ul class="ml-4 list-disc space-y-1 text-sm text-slate-600">
            <li>Write <code>motion-blocks.json</code> with framework-aware paths</li>
            <li>Download component source files from the registry</li>
            <li>Resolve registry dependencies (e.g. shared gsap helper)</li>
            <li>Install required npm dependencies (GSAP, Lit, etc.)</li>
            <li>Enable <code>experimentalDecorators</code> in your tsconfig when needed</li>
            <li>Print a framework-specific usage snippet after install</li>
          </ul>

          <p>
            Each component page shows the exact <code>motion-blocks add</code> command
            ready to copy.
          </p>
        </div>
      </section>

      <section id="cli-commands" class="flex flex-col gap-4 scroll-mt-24">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">
          CLI Commands
        </h2>
        <div class="flex flex-col gap-3 text-sm leading-7 text-slate-600">
          <p>Browse and inspect the registry before installing:</p>

          <PackageCommand command="motion-blocks list" />
          <p>
            Use <code>--all</code> to include hidden helper libs such as the
            shared gsap module:
          </p>
          <PackageCommand command="motion-blocks list --all" />

          <p>Inspect detected project info and your config:</p>
          <PackageCommand command="motion-blocks info" />

          <p>
            Maintainers can validate registry source manifests without writing
            files:
          </p>
          <CodeBlock code="pnpm registry:build:check" />
        </div>
      </section>

      <section id="configuration" class="flex flex-col gap-4 scroll-mt-24">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">
          Configuration
        </h2>
        <div class="flex flex-col gap-3 text-sm leading-7 text-slate-600">
          <p>
            <code>motion-blocks init</code> writes a <code>motion-blocks.json</code> file
            at your project root. You can edit it to override detection results:
          </p>

          <CodeBlock code={motionKitConfig} showLineNumbers />

          <p>
            Key fields:
          </p>
          <ul class="ml-4 list-disc space-y-1 text-sm text-slate-600">
            <li><code>registry</code> — base URL for registry payloads (required)</li>
            <li><code>framework</code> — affects install paths and usage snippets</li>
            <li><code>componentsDir</code> — where component files are written</li>
            <li><code>helpersDir</code> — where shared helper libs are written</li>
          </ul>

          <p>
            Lit-based components need decorators enabled when your project compiles
            TypeScript:
          </p>
          <CodeBlock code={tsconfigDecorators} showLineNumbers />
        </div>
      </section>

      <section id="project-structure" class="flex flex-col gap-4 scroll-mt-24">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">
          Project Structure
        </h2>
        <div class="flex flex-col gap-3 text-sm leading-7 text-slate-600">
          <p>
            After installing components, your project typically looks like this:
          </p>
          <CodeBlock code={projectStructure} />
          <p>
            Register custom elements in client code before using them in markup:
          </p>
          <CodeBlock code={importExample} showLineNumbers />
        </div>
      </section>

      <section id="frameworks" class="flex flex-col gap-4 scroll-mt-24">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">
          Framework Support
        </h2>
        <p class="text-sm text-slate-600">
          Motion Blocks components work with any framework that supports Web
          Components. Starter templates live in the repo under <code
            class="rounded bg-slate-100 px-1.5 py-0.5 text-[0.9em] text-slate-800"
            >templates/</code
          >:
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 sm:gap-6">
          <CardLink
            href="#astro"
            title="Astro"
            description="First-class support"
            align="center"
          >
            <AstroLogo slot="icon" />
          </CardLink>

          <CardLink
            href="#next"
            title="Next.js"
            description="Client components"
            align="center"
          >
            <NextJsLogo slot="icon" />
          </CardLink>

          <CardLink
            href="#svelte"
            title="SvelteKit"
            description="Full support"
            align="center"
          >
            <SvelteLogo slot="icon" />
          </CardLink>

          <CardLink
            href="#vue"
            title="Vue"
            description="Web Components"
            align="center"
          >
            <VueLogo slot="icon" />
          </CardLink>

          <CardLink
            href="#react"
            title="React"
            description="Custom Elements"
            align="center"
          >
            <ReactLogo slot="icon" />
          </CardLink>

          <CardLink
            href="#vanilla"
            title="Vanilla JS"
            description="Any setup"
            align="center"
          >
            <JavaScriptLogo slot="icon" />
          </CardLink>
        </div>
      </section>

      <section id="troubleshooting" class="flex flex-col gap-4 scroll-mt-24">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">
          Troubleshooting
        </h2>
        <div class="flex flex-col gap-4 text-sm leading-7 text-slate-600">
          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >No motion-blocks.json found</strong
              >
            </p>
            <p>
              Run <code>motion-blocks init</code> in your project root before
              <code>motion-blocks add</code>.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Registry item not found</strong
              >
            </p>
            <p>
              Run <code>motion-blocks list</code> to see available names. Check that
              <code>registry</code> in <code>motion-blocks.json</code> points at a
              valid catalog URL.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Invalid registry item</strong
              >
            </p>
            <p>
              The fetched payload failed validation. If you maintain the
              registry, run <code>motion-blocks build --check</code> from the Motion
              Kit repo to inspect source manifests.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Unsafe target path</strong
              >
            </p>
            <p>
              The CLI refused to write outside your project. This indicates a bad
              <code>target</code> path in the registry item — report it upstream.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >File already exists</strong
              >
            </p>
            <p>
              Re-run with <code>--overwrite</code> to replace installed files, or
              delete the conflicting file manually.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Dependency install failed</strong
              >
            </p>
            <p>
              Retry with <code>--no-install</code> and run the printed package
              manager command manually. pnpm store mismatches can be fixed with
              <code>rm -rf node_modules && pnpm install</code>.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Asset copy failed</strong
              >
            </p>
            <p>
              Check your network connection and the <code>registry</code> URL.
              Assets are fetched from the registry, not inlined in payloads.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Unsupported framework</strong
              >
            </p>
            <p>
              If <code>motion-blocks init</code> cannot detect your framework, set
              <code>framework</code> manually in <code>motion-blocks.json</code> and
              adjust <code>componentsDir</code> / <code>helpersDir</code> to match
              your project layout.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900"
                >Components not rendering?</strong
              >
            </p>
            <p>
              Register the custom element in client code before using it in
              markup. In Astro, import in a <code>&lt;script&gt;</code> block, not
              frontmatter.
            </p>
          </div>

          <div>
            <p>
              <strong class="font-semibold text-slate-900">Build errors?</strong>
            </p>
            <p>
              Ensure your build tool supports TypeScript, Web Components, and Lit
              decorators. Enable <code>experimentalDecorators</code> in
              <code>tsconfig.json</code> when you compile registry source.
            </p>
          </div>
        </div>
      </section>
    </article>

    <Fragment slot="aside">
      <ComponentToc items={tocItems} />
    </Fragment>
  </ComponentBrowserShell>
</SiteLayout>
