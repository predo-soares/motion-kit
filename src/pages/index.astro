---
import SiteLayout from "@/layouts/site-layout.astro";
import Logo from "@/components/vectors/logo.astro";
---

<SiteLayout title="Motion Blocks — Astro Registry">
  <div
    class="relative flex h-dvh flex-col items-center justify-center gap-9 overflow-hidden px-4 text-center"
  >
    <!-- Blue radial glow -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background:rgb(191 219 254 / 0.4)"
    >
    </div>

    <!-- Edge gradient borders -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to right, rgb(255 255 255 / 0.85) 0%, transparent 6%, transparent 94%, rgb(255 255 255 / 0.85) 100%)"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to bottom, rgb(255 255 255 / 0.85) 0%, transparent 70%, transparent 94%, rgb(255 255 255 / 0.85) 100%)"
    >
    </div>

    <div class="absolute left-1/2 -translate-x-1/2 top-10">
      <Logo class="h-14" />
    </div>
    <!-- Headline -->
    <div data-animate class="opacity-0 flex flex-col items-center gap-5">
      <h1
        class="max-w-2xl text-5xl font-semibold tracking-tight text-slate-950 sm:text-6xl lg:text-[5rem] lg:leading-[1.08]"
      >
        Motion that drops<br />into <span class="text-blue-500">anything.</span>
      </h1>
      <p
        class="max-w-md text-base leading-7 text-slate-500 sm:text-lg text-balance"
      >
        Animated web components installed in one command. No adapters, no
        rewrites, no drama.
      </p>
    </div>

    <!-- CTA buttons -->
    <div
      data-animate
      class="opacity-0 flex flex-wrap items-center justify-center gap-3"
    >
      <motion-magnetic strength="0.4">
        <a
          href="/docs/components"
          data-audio-hover="hover"
          data-audio-click="select"
          class="inline-flex items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-slate-700"
        >
          Browse Components
        </a>
      </motion-magnetic>
      <motion-magnetic strength="0.4">
        <a
          href="/docs/introduction"
          data-audio-hover="hover"
          data-audio-click="select"
          class="inline-flex items-center justify-center gap-1.5 rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-medium text-slate-700 shadow-sm transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900"
        >
          Getting Started
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </motion-magnetic>
    </div>
  </div>
</SiteLayout>

<script>
  import { gsap } from "gsap";
  import "@/registry/interaction/magnetic/magnetic-element";

  gsap.to("[data-animate]", {
    opacity: 1,
    y: -24,
    duration: 1.6,
    ease: "elastic.out(1, 0.5)",
    stagger: 0.18,
  });
</script>
