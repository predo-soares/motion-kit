{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "spotlight-card",
  "title": "Spotlight Card",
  "description": "A single-file Astro marketing card with a soft glow.",
  "files": [
    {
      "path": "src/registry/new-york/blocks/spotlight-card/spotlight-card.astro",
      "content": "---\nexport interface Props {\n  eyebrow?: string\n  title: string\n  copy: string\n  href?: string\n  ctaLabel?: string\n}\n\nconst {\n  eyebrow = \"Motion Kit\",\n  title,\n  copy,\n  href,\n  ctaLabel = \"Read more\",\n} = Astro.props\n---\n\n<article class=\"relative grid gap-5 overflow-hidden border border-slate-400/25 rounded-[1.75rem] p-6 text-slate-200 [background:radial-gradient(circle_at_top_right,rgba(56,189,248,0.2),transparent_35%),linear-gradient(160deg,rgb(15_23_42),rgb(17_24_39))] shadow-[inset_0_1px_0_rgba(255,255,255,0.06),0_24px_80px_rgba(2,6,23,0.45)] after:content-[''] after:absolute after:right-[-15%] after:bottom-[-45%] after:w-44 after:aspect-square after:rounded-full after:bg-pink-400/15 after:blur-xl\">\n  <div class=\"relative z-10 grid gap-3\">\n    <span class=\"text-[0.72rem] font-bold tracking-[0.12em] uppercase text-sky-300\">{eyebrow}</span>\n    <h2 class=\"m-0 text-[clamp(1.6rem,3vw,2.25rem)] leading-[0.98] text-balance\">{title}</h2>\n    <p class=\"m-0 max-w-[48ch] leading-[1.6] text-slate-200/80\">{copy}</p>\n  </div>\n\n  {\n    href && (\n      <a\n        href={href}\n        class=\"relative z-10 inline-flex w-fit items-center justify-center border border-sky-300/30 rounded-full py-[0.7rem] px-4 font-semibold text-white no-underline bg-slate-900/70 transition-[transform,border-color,background] duration-[180ms] ease-in-out hover:-translate-y-px hover:border-sky-300/60 hover:bg-slate-900/90\"\n      >\n        {ctaLabel}\n      </a>\n    )\n  }\n</article>\n",
      "type": "registry:component",
      "target": "src/components/motion-kit/spotlight-card.astro"
    }
  ],
  "type": "registry:component"
}