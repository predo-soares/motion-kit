{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://motionkit.dev/schemas/motion-kit.json",
  "title": "Motion Kit Configuration",
  "description": "Configuration for Motion Kit registry CLI",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema URL for validation"
    },
    "registry": {
      "type": "string",
      "description": "Base URL for the Motion Kit registry",
      "default": "https://motionkit.dev/r"
    },
    "framework": {
      "type": "string",
      "enum": ["astro", "next", "react", "vue", "nuxt", "svelte", "sveltekit", "plain"],
      "description": "Detected or overridden framework"
    },
    "packageManager": {
      "type": "string",
      "enum": ["pnpm", "npm", "yarn", "bun"],
      "description": "Detected package manager"
    },
    "componentsDir": {
      "type": "string",
      "description": "Directory where component files are installed"
    },
    "helpersDir": {
      "type": "string",
      "description": "Directory where helper files are installed"
    }
  },
  "required": ["registry"]
}
