{
  "name": "motion-blocks",
  "version": "0.0.2",
  "type": "module",
  "description": "CLI for the Motion Blocks registry — install, build, and inspect animated Web Component items.",
  "keywords": [
    "motion-blocks",
    "web-components",
    "animation",
    "registry",
    "cli",
    "astro",
    "react",
    "nextjs",
    "svelte",
    "vue"
  ],
  "homepage": "https://motionkit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/predo-soares/motion-kit.git",
    "directory": "packages/motion-blocks-cli"
  },
  "bugs": {
    "url": "https://github.com/predo-soares/motion-kit/issues"
  },
  "bin": {
    "motion-blocks": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types ./src/index.ts",
    "test": "pnpm build && node --test dist/catalog/filter-catalog.test.js dist/install/resolve-config.test.js dist/install/resolve-registry-graph.test.js dist/install/patch-tsconfig.test.js dist/install/patch-vite-config.test.js"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^6.0.3"
  }
}
